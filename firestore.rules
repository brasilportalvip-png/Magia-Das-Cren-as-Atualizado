rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Users collection
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.get('credits', 0) == 0;
      allow update: if isOwner(userId) 
                    && request.resource.data.get('credits', 0) == resource.data.get('credits', 0)
                    && request.resource.data.get('plan', 'free') == resource.data.get('plan', 'free');

      // Consultations subcollection
      match /consultations/{consultationId} {
        allow read, write: if isOwner(userId);
      }

      // Transactions subcollection
      match /transactions/{transactionId} {
        allow read: if isOwner(userId);
      }
    }
  }
}
